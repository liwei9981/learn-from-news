TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# Search providers
NEWS_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
TAVILY_API_KEY=

# NotebookLM browser automation
NOTEBOOKLM_USER_DATA_DIR=.local/notebooklm-browser
NOTEBOOKLM_BASE_URL=https://notebooklm.google.com
NOTEBOOKLM_ENABLED=false
NOTEBOOKLM_STORAGE_PATH=
NOTEBOOKLM_AUDIO_TIMEOUT_SECONDS=1800
NOTEBOOKLM_INFOGRAPHIC_TIMEOUT_SECONDS=1800
NOTEBOOKLM_SOURCE_WAIT_SECONDS=180
NOTEBOOKLM_RESEARCH_TIMEOUT_SECONDS=900
NOTEBOOKLM_RESEARCH_POLL_SECONDS=15
NOTEBOOKLM_RESEARCH_MODE=fast
NOTEBOOKLM_IMPORT_RESEARCH_SOURCES=true
NOTEBOOKLM_MAX_RESEARCH_SOURCES=12
NOTEBOOKLM_OUTPUT_DIR=.local/notebooklm-output
NOTEBOOKLM_MAX_SOURCES=10

# Product defaults
DEFAULT_LANGUAGE=en
DEFAULT_REGION=US
DEFAULT_MAX_NEWS_RESULTS=10
DEFAULT_LOOKBACK_DAYS=7
PODCAST_TARGET_MINUTES=15
ALLOW_FALLBACK_RESULTS=false
NOTEBOOKLM_PROGRESS_INTERVAL_SECONDS=300
